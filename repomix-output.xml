---
import type { PortfolioData } from '../../types/portfolio';
import type { SectionName } from '../../lib/schema';
import { SECTION_COMPONENTS, getSectionData } from '../../lib/sections';
import Container from '../../components/ui/Container.astro';
import './styles.css';

interface Props {
  data: PortfolioData;
  sections: readonly SectionName[];
}

const { data, sections } = Astro.props;

const RenderList = sections.map((name) => ({
  name,
  Section: SECTION_COMPONENTS[name],
  data: getSectionData(data, name),
}));

// When the configured order starts with hero, keep the original composition:
// hero in its own bordered header, the rest stacked inside <main>.
const IsHeroFirst = RenderList[0]?.name === 'hero';
const HeroSection = IsHeroFirst ? RenderList[0].Section : undefined;
const HeroData = IsHeroFirst ? RenderList[0].data : undefined;
const Stack = IsHeroFirst ? RenderList.slice(1) : RenderList;
---

<div class="japanese-layout">
  <!-- Subtle decorative Hanko / Japanese stamp accent element -->
  <div class="hanko-seal" aria-hidden="true">ポートフォリオ</div>

  <Container>
    <div class="japanese-frame">
      {HeroSection && (
        <header class="japanese-hero-wrapper">
          <HeroSection data={HeroData} />
        </header>
      )}

      <main class="japanese-main">
        {Stack.map(({ name, Section, data: sectionData }) => (
          <div
            class={name === 'hero'
              ? 'japanese-hero-wrapper'
              : 'japanese-section-wrapper'}
          >
            <Section data={sectionData} />
          </div>
        ))}
      </main>
    </div>
  </Container>
</div>
</file>

